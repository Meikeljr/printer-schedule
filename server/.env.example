PORT=5000

# Supabase local (run `npx supabase start` from the repository root)
DB_HOST=127.0.0.1
DB_PORT=54322
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false
DB_FALLBACK_SQLITE=false

# For hosted Supabase, use its PostgreSQL connection string instead:
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# DB_SSL=true
